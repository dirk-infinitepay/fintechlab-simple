# syntax=docker/dockerfile:1
FROM docker.io/library/golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/lab-api ./cmd/labapi

FROM docker.io/library/alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/lab-api /usr/local/bin/lab-api
# Same file banking-circle bakes in, read as the fallback when the service
# cannot be asked what schedule it runs. Compose mounts ./config over it.
COPY config/banking-circle.json /config/banking-circle.json
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/lab-api"]
