# deploy/aws/lab.sh reads deploy/aws/lab.env (copy this file; it is
# gitignored). Variables set in the environment win over this file.
# Nothing here is secret, but it is yours: addresses and an account id.

# Which AWS credentials and where. Leave AWS_PROFILE empty for the default
# chain (aws sso login, environment variables).
AWS_PROFILE=
AWS_REGION=eu-west-1

# Refuse to run against any other account -- worth setting when the account
# holds other workloads too.
LAB_ACCOUNT_ID=

# The stack's name. Two stacks with different names are two independent labs.
LAB_STACK=fintechlab-dev

# Who may reach the lab, comma-separated CIDRs: your office or VPN egress,
# and the platform's outbound addresses (its NAT gateways' Elastic IPs) if a
# deployed platform calls the lab. Empty: nothing is reachable from outside,
# and the console is 'lab.sh console' (an SSM port forward) only.
LAB_ALLOWED_CIDRS=

# The name the lab is reached at. Empty: its Elastic IP, which is stable for
# the life of the stack. With LAB_HOSTED_ZONE_ID (a Route 53 public zone you
# own) the stack writes the A record; without it, point the name at the
# PublicIp output yourself. Changing it after the first deploy needs new
# certificates: REGENERATE_KEYS=true lab.sh deploy.
LAB_DOMAIN=
LAB_HOSTED_ZONE_ID=

# The platform's webhook and callback hosts, comma-separated -- added to every
# vendor's webhook allowlist, so Banking Circle and B4B may call them.
LAB_WEBHOOK_ALLOW=

# Per-container overrides, space-separated container.KEY=value: callback
# targets the lab dials itself, delivery delays. For example
#   LAB_SET="aci.ACI_WEBHOOK_TARGET_URL=https://hooks.example.com/aci"
LAB_SET=

LAB_INSTANCE_TYPE=t3.small
